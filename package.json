{
  "name": "star-ng-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace of StarNG: the star-ng component library and its docs application.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve docs",
    "build": "ng build star-ng && node tools/build-styles.mjs && ng build docs",
    "build:lib": "ng build star-ng && node tools/build-styles.mjs",
    "check:package": "node tools/check-package.mjs",
    "smoke:consumer": "node tools/smoke-consumer.mjs",
    "build:docs": "ng build docs",
    "build:pages": "node tools/build-pages.mjs",
    "pages:preview": "node tools/build-pages.mjs && node tools/pages-serve.mjs",
    "test": "ng test star-ng",
    "test:ci": "ng test star-ng --watch=false --coverage",
    "lint": "ng lint && node tools/gen-docs-data.mjs --check && node tools/check-names.mjs",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:gen": "node tools/gen-docs-data.mjs",
    "docs:check": "node tools/gen-docs-data.mjs --check",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test --grep @a11y",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "e2e:visual:update": "node tools/visual-update.mjs",
    "e2e:pages": "node tools/build-pages.mjs && playwright test -c playwright.pages.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@phosphor-icons/web": "^2.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco": "^8.4.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.108.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
