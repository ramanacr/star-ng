{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/star-ng",
  "assets": [
    {
      "glob": "**/*.scss",
      "input": "styles",
      "output": "styles"
    },
    {
      "glob": "star-theme-first-paint.js",
      "input": "theme",
      "output": "theme"
    }
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
